 secret&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;replaces: Service connection&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1045" y="310" width="245" height="130" as="geometry"/></mxCell><mxCell id="p5C2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;SHARED PIPELINE PARTS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Reusable workflows&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;ADHPlatform/platform-workflows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;called by commit SHA (later step)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;replaces: .global&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="375" y="500" width="245" height="120" as="geometry"/></mxCell><mxCell id="p5C3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;SETTINGS AND APPROVALS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;GitHub environments&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;nonprod / prod: AZURE_*, TF_STATE_*&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;required reviewers on prod&lt;/font&gt;