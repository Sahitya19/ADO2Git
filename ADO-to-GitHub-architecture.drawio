torage, Key Vault, Entra&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243B6B;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="245" y="632" width="365" height="43" as="geometry"/></mxCell><mxCell id="p6g10" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Same resources, same state file&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DDE3EF;strokeColor=#243B6B;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="660" y="632" width="365" height="43" as="geometry"/></mxCell><mxCell id="p6w10" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;First plan must say No changes&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1035" y="632" width="260" height="43" as="geometry"/></mxCell><mxCell id="p6r0" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1F6FB2;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a0" target="p6g0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a1" target="p6g1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a2" target="p6g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1F6FB2;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a3" target="p6g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B85E0E;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a4" target="p6g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B85E0E;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a5" target="p6g5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r6" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#0F7C74;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a6" target="p6g6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r7" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B0302F;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a7" target="p6g7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r8" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a8" target="p6g8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r9" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a9" target="p6g9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6r10" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#243B6B;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6a10" target="p6g10"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="How an SPN change travels"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;How an SPN change travels&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;PR  →  plan  →  merge  →  apply  →  tag, from NonProd to Prod&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1100" height="70" as="geometry"/></mxCell><mxCell id="p7lane1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#DDE3E8;strokeWidth=0.75;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="1255" height="175" as="geometry"/></mxCell><mxCell id="p7lane1t" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;1. Change the module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;SPN repo&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="48" y="135" width="145" height="155" as="geometry"/></mxCell><mxCell id="p7lane2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#DDE3E8;strokeWidth=0.75;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="1255" height="215" as="geometry"/></mxCell><mxCell id="p7lane2t" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;2. Deploy it&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;deploy repo, custodian SBX&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="48" y="345" width="145" height="195" as="geometry"/></mxCell><mxCell id="p7m0" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;STEP 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Pull request&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;change the module code in ADHPlatform/SPN&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="200" y="145" width="155" height="135" as="geometry"/></mxCell><mxCell id="p7m1" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;STEP 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Checks&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;fmt + validate on ubuntu-latest, no Azure&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="382" y="145" width="155" height="135" as="geometry"/></mxCell><mxCell id="p7m2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;STEP 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Review + merge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;a teammate approves, merge to main&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="564" y="145" width="155" height="135" as="geometry"/></mxCell><mxCell id="p7m3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;STEP 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Tag&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;push v0.0.5: this is the new version&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="746" y="145" width="155" height="135" as="geometry"/></mxCell><mxCell id="p7d0" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;STEP 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Pull request&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;SBX NonProd manifest: SPN 0.0.5 (or a tfvars change)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="200" y="355" width="155" height="175" as="geometry"/></mxCell><mxCell id="p7d1" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;STEP 6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Plan&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;on the VNET runner, OIDC sign-in; summary shows what would change&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="382" y="355" width="155" height="175" as="geometry"/></mxCell><mxCell id="p7d2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;STEP 7&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Review + merge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;team reads the plan and approves&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="564" y="355" width="155" height="175" as="geometry"/></mxCell><mxCell id="p7d3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;STEP 8&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Apply NonProd&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;manual run from main applies the saved plan&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="746" y="355" width="155" height="175" as="geometry"/></mxCell><mxCell id="p7d4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;STEP 9&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Promote&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;PR sets the SBX Prod manifest to the same tag; plan runs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="928" y="355" width="155" height="175" as="geometry"/></mxCell><mxCell id="p7d5" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B0302F&quot;&gt;&lt;b&gt;STEP 10&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Apply Prod&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;waits for prod reviewers, then applies&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1110" y="355" width="155" height="175" as="geometry"/></mxCell><mxCell id="p7note" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;First run after the move: the plan must say &amp;quot;No changes&amp;quot;. GitHub uses the same state file as Azure DevOps, so a clean plan proves nothing was lost.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Nothing reaches Prod without two reviews: the promotion PR and the prod environment approval.&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E8C267;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="1255" height="85" as="geometry"/></mxCell><mxCell id="p7me1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7m0" target="p7m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7me2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7m1" target="p7m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7me3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7m2" target="p7m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7de1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7d0" target="p7d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7de2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7d1" target="p7d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7de3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7d2" target="p7d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7de4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7d3" target="p7d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7de5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7d4" target="p7d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7link" value="new tag goes into the manifest" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="p7m3" target="p7d0"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="Who does what"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Who does what&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;After the move&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1100" height="70" as="geometry"/></mxCell><mxCell id="p8rh0" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Module developers&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F6FB2;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="405" height="50" as="geometry"/></mxCell><mxCell id="p8rb0" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Change module code by pull request&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Merge after review, push the version tag&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F2933&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Where: module repos (ADHPlatform/SPN, ...)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="405" height="170" as="geometry"/></mxCell><mxCell id="p8rh1" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Custodian teams (e.g. SBX)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F7C74;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="465" y="120" width="405" height="50" as="geometry"/></mxCell><mxCell id="p8rb1" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Change tfvars or bump a version in the manifest by PR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Read the plan before anyone merges&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F2933&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Where: deploy repo, CoreInfra/&amp;lt;custodian&amp;gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="465" y="170" width="405" height="170" as="geometry"/></mxCell><mxCell id="p8rh2" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Prod reviewers&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B0302F;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="890" y="120" width="405" height="50" as="geometry"/></mxCell><mxCell id="p8rb2" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Approve the promotion PR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Approve the apply in the prod environment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F2933&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Where: GitHub environment &amp;#x27;prod&amp;#x27;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="890" y="170" width="405" height="170" as="geometry"/></mxCell><mxCell id="p8rh3" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Platform team (Harsha)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B85E0E;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="405" height="50" as="geometry"/></mxCell><mxCell id="p8rb3" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Repos, tags, environments, reviewers, rulesets&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Workflows, reusable workflows, migration script&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F2933&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Where: ADHPlatform repos (repo admin)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="405" height="170" as="geometry"/></mxCell><mxCell id="p8rh4" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;GitHub org / enterprise owners&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#56636D;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="465" y="370" width="405" height="50" as="geometry"/></mxCell><mxCell id="p8rb4" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Runner group access, Actions policy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Org rulesets, GitHub Apps (VNET already done)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F2933&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Where: org and enterprise settings&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="465" y="420" width="405" height="170" as="geometry"/></mxCell><mxCell id="p8rh5" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Azure, Entra and network admins&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243B6B;strokeColor=#243B6B;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="890" y="370" width="405" height="50" as="geometry"/></mxCell><mxCell id="p8rb5" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• Federated credential per environment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F2933&quot;&gt;• State storage role, firewall allows 52.242.194.21&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot; color=&quot;#1F2933&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Where: Entra ID, subscription, ServiceNow&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDE3EF;strokeColor=#243B6B;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="890" y="420" width="405" height="170" as="geometry"/></mxCell><mxCell id="p8whonote" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Day-to-day roles after the move. Team names are proposals; the org-admin vs owner split is still to confirm (see CALL-BRIEF).&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="1255" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>