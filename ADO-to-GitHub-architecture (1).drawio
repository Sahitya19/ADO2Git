&quot;#1F2933&quot;&gt;&lt;b&gt;Cencora VNET runners&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;group cencora, egress 52.242.194.21&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;ubuntu-latest for checks only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;replaces: ADO agents&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="710" y="310" width="245" height="130" as="geometry"/></mxCell><mxCell id="p2B4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B0302F&quot;&gt;&lt;b&gt;SIGN-IN TO AZURE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;OIDC federated credentials&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;one per GitHub environment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;no secret anywhere&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;replaces: Service connections&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1045" y="310" width="245" height="130" as="geometry"/></mxCell><mxCell id="p2C2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;SHARED PIPELINE PARTS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&