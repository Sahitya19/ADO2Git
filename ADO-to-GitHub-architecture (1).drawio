olor=&quot;#1F6FB2&quot;&gt;&lt;b&gt;MODULE CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;ADHPlatform/SPN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;one repo per module, history kept&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;ci.yml: fmt + validate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;replaces: Modernization_Terraform&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="245" height="120" as="geometry"/></mxCell><mxCell id="p11A2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;RELEASE A VERSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Merge to main + push a tag&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;the tag vX.Y.Z is the release&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;nothing to build or upload&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;replaces: Module publish pipeline&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="375" y="130" width="245" height="120" as="geometry"/></mxCell><mxCell id="p11A3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B4FA0&quot;