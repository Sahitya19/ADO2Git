=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="799" y="130" width="238" height="50" as="geometry"/></mxCell><mxCell id="p8ib3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;&lt;b&gt;TAGS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;tags = its feed versions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;adh-iac-terraform-apim&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;ci.yml · release-please · CHANGELOG&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#B85E0E&quot;&gt;&lt;i&gt;&lt;b&gt;to move&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="799" y="180" width="238" height="155" as="geometry"/></mxCell><mxCell id="p8iv4" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;ADHPlatform/SPN&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F7C74;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1052" y="130" width="238" height="50" as="geometry"/></mxCell><mxCell id="p8ib4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#5F6B76&quot;&gt;&lt;b&gt;TAGS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;v0.0.1  v0.0.2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;v0.0.3  v0.0.4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;ci.yml · release-please · CHANGELOG&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#0F7C74&quot;&gt;&lt;i&gt;&lt;b&gt;first: repo pushed, tags next&lt;/b&gt;&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1052" y="180" width="238" height="155" as="geometry"/></mxCell><mxCell id="p8iv_more" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;... and every other module in Modules/ (about 40 assumed, count to confirm): each becomes its own repo with the same layout, and its feed versions become its tags.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#C9D1D9;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1250" height="60" as="geometry"/></mxCell><mxCell id="p8iw_h" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;b&gt;EVERY MODULE MOVES THE SAME WAY, ONE AT A TIME, WITH THE SAME SCRIPT&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1250" height="32" as="geometry"/></mxCell><mxCell id="p8iw0" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;1. Split&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;Modules/&amp;lt;Module&amp;gt; with its history becomes ADHPlatform/&amp;lt;Module&amp;gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="238" height="135" as="geometry"/></mxCell><mxCell id="p8iw1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;2. Tag&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;each feed version becomes a tag on the commit it was built from&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="293" y="480" width="238" height="135" as="geometry"/></mxCell><mxCell id="p8iw2" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;3. Template&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;add ci.yml, release-please, CODEOWNERS, tag ruleset&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="546" y="480" width="238" height="135" as="geometry"/></mxCell><mxCell id="p8iw3" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;4. Switch&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;the deploy workflow clones the tag; manifests stay as they are&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="799" y="480" width="238" height="135" as="geometry"/></mxCell><mxCell id="p8iw4" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;5. Retire&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;stop publishing this module to the feed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1052" y="480" width="238" height="135" as="geometry"/></mxCell><mxCell id="p8iwe1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6B4FA0;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8iw0" target="p8iw1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8iwe2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#B85E0E;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8iw1" target="p8iw2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8iwe3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#0F7C74;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8iw2" target="p8iw3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8iwe4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p8iw3" target="p8iw4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="SPN today"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750"