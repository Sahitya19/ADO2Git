xGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2e9" value="short-lived token" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2B4" target="p2C4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="Every module repo looks the same"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Every module repo looks the same&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;One repo per module, one template  ·  ADHPlatform/&amp;lt;Module&amp;gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1100" height="70" as="geometry"/></mxCell><mxCell id="p3tree" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;ADHPlatform/&amp;lt;Module&amp;gt;          e.g. ADHPlatform/SPN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── main.tf  variables.tf  outputs.tf&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── versions.tf&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── examples/basic/main.tf&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── README.md&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── CHANGELOG.md&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── CODEOWNERS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── .checkov.yml&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── release-please-config.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;├── .release-please-manifest.json&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;└── .github/workflows/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;    ├── ci.yml&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;    └── release-please.yml&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;&lt;b&gt;tags:  v0.0.1  v0.0.2  ...  vX.Y.Z&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#E6EDF3&quot;&gt;releases: one GitHub Release per tag&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F2933;strokeColor=#1F2933;strokeWidth=1.25;fontFamily=Consolas;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="530" height="510" as="geometry"/></mxCell><mxCell id="p3cl0" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;The module&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F6FB2;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="120" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd0" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;main.tf, variables.tf, outputs.tf, versions.tf: the Terraform code, moved from Modules/&amp;lt;Module&amp;gt; with its history&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="120" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3cl1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;examples/ + README&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F6FB2;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="194" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd1" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;a working example and usage pinned to a tag: source = git::...?ref=vX.Y.Z&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="194" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3cl2" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;CHANGELOG.md&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6B4FA0;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="268" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd2" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;written by release-please from commit messages. Nobody edits it by hand&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="268" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3cl3" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;CODEOWNERS&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#56636D;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="342" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd3" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;module maintainers must approve every pull request&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="342" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3cl4" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;ci.yml&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#B85E0E;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="416" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd4" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;every PR: fmt, validate, tflint, checkov, PR title check. Runs on ubuntu-latest&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="416" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3cl5" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;release-please.yml + config&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6B4FA0;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="490" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd5" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;on merge to main: opens or updates the release PR; merging it creates the tag and GitHub Release&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="490" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3cl6" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Tags v*&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#B0302F;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="595" y="564" width="235" height="64" as="geometry"/></mxCell><mxCell id="p3cd6" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;protected by a ruleset: they can&amp;#x27;t be moved or deleted, so a pinned version never changes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="840" y="564" width="450" height="64" as="geometry"/></mxCell><mxCell id="p3lay_note" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Same layout in every module repo, from one template (copilot-migration/templates/module-repo). Repo naming (ADHPlatform/&amp;lt;Module&amp;gt; or terraform-azurerm-&amp;lt;module&amp;gt;) is still a proposal.&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="1250" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Module lifecycle: from change to release"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Module lifecycle: from change to release&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;Branch  →  PR checks  →  merge  →  release PR  →  tag + changelog&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1100" height="70" as="geometry"/></mxCell><mxCell id="p4ml0" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;STEP 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Feature branch&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;commit: &amp;quot;feat: add private endpoint input&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="195" height="175" as="geometry"/></mxCell><mxCell id="p4ml1" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;STEP 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Pull request&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;ci.yml: fmt, validate, tflint, checkov, PR title (ubuntu-latest)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="251" y="130" width="195" height="175" as="geometry"/></mxCell><mxCell id="p4ml2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;STEP 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Review + merge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;CODEOWNERS approve, merge to main&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="462" y="130" width="195" height="175" as="geometry"/></mxCell><mxCell id="p4ml3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;STEP 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Release PR opens&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;release-please: next version + CHANGELOG entry&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="673" y="130" width="195" height="175" as="geometry"/></mxCell><mxCell id="p4ml4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;STEP 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Merge release PR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;when you&amp;#x27;re ready to publish; several changes can go in one release&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="884" y="130" width="195" height="175" as="geometry"/></mxCell><mxCell id="p4ml5" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;STEP 6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Tag + Release&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;vX.Y.Z tag and GitHub Release with the notes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1095" y="130" width="195" height="175" as="geometry"/></mxCell><mxCell id="p4cc_h" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;b&gt;THE COMMIT MESSAGE DECIDES THE VERSION (CONVENTIONAL COMMITS)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1250" height="35" as="geometry"/></mxCell><mxCell id="p4v0" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;fix: ...&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;PATCH&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;1.4.2  →  1.4.3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;a bug fix, nothing new for users&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="405" height="155" as="geometry"/></mxCell><mxCell id="p4v1" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;feat: ...&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;MINOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;1.4.2  →  1.5.0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;a new input or feature, old callers still work&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="462" y="380" width="405" height="155" as="geometry"/></mxCell><mxCell id="p4v2" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#B0302F&quot;&gt;&lt;b&gt;feat!: ...  or  BREAKING CHANGE:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;MAJOR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;1.4.2  →  2.0.0&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;callers must change; before 1.0.0 this bumps the minor&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="884" y="380" width="405" height="155" as="geometry"/></mxCell><mxCell id="p4ml_note" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;No pipeline builds or uploads anything. A release is a tag on a reviewed commit, and its notes come from the commit messages.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;chore:, docs:, ci: and test: change no version. Tags are never created or moved by hand.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E8C267;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1250" height="85" as="geometry"/></mxCell><mxCell id="p4mle1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4ml0" target="p4ml1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4mle2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4ml1" target="p4ml2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4mle3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4ml2" target="p4ml3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4mle4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4ml3" target="p4ml4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4mle5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4ml4" target="p4ml5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="How custodians take a new module version"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;How custodians take a new module version&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;Manifest bump PR  →  plan per custodian  →  apply NonProd  →  promote to Prod&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1100" height="70" as="geometry"/></mxCell><mxCell id="p5mc_rel" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;MODULE RELEASED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;ADHPlatform/SPN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B76&quot;&gt;new tag v0.0.5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="240" height="130" as="geometry"/></mxCell><mxCell id="p5mc_bump" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;MANIFEST BUMP PR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;one line per custodian + env&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;by hand today; Renovate (regex rule) can automate it later&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="290" height="130" as="geometry"/></mxCell><mxCell id="p5mf0" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;CoreInfra/AHP/NonProd&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;modules_manifest.csv: SPN,0.0.4&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;stays on 0.0.4 until ready&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FB2;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="675" y="120" width="275" height="90" as="geometry"/></mxCell><mxCell id="p5mf1" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;CoreInfra/SBX/NonProd&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;modules_manifest.csv: SPN,0.0.5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;takes the new version&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.5;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="675" y="225" width="275" height="90" as="geometry"/></mxCell><mxCell id="p5mf2" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;CoreInfra/.../~40 custodians&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;modules_manifest.csv: SPN,&amp;lt;ver&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;each moves at its own pace&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FB2;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="675" y="330" width="275" height="90" as="geometry"/></mxCell><mxCell id="p5mc_wf" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;&amp;lt;MODULE&amp;gt;-TERRAFORM.YML&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;plans every changed custodian&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;Cencora runners, OIDC&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1005" y="140" width="285" height="130" as="geometry"/></mxCell><mxCell id="p5mcs0" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;STEP 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Plan in the PR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;shows what changes in Azure for SBX NonProd&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="235" height="130" as="geometry"/></mxCell><mxCell id="p5mcs1" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;STEP 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Review + merge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;the custodian team approves&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="294" y="455" width="235" height="130" as="geometry"/></mxCell><mxCell id="p5mcs2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;STEP 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Apply NonProd&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;manual run from main&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="548" y="455" width="235" height="130" as="geometry"/></mxCell><mxCell id="p5mcs3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;STEP 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Promote PR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;SBX Prod manifest to v0.0.5&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="802" y="455" width="235" height="130" as="geometry"/></mxCell><mxCell id="p5mcs4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B0302F&quot;&gt;&lt;b&gt;STEP 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Apply Prod&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;after prod reviewers approve&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1056" y="455" width="235" height="130" as="geometry"/></mxCell><mxCell id="p5mc_h2" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;b&gt;THEN THE SAME PULL REQUEST GOES THROUGH&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="590" height="32" as="geometry"/></mxCell><mxCell id="p5mc_note" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#5F6B76&quot;&gt;&lt;i&gt;Dependabot can&amp;#x27;t read modules_manifest.csv (it only bumps source = ...?ref= lines), so the bump is a small PR by hand or with Renovate.&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="1250" height="50" as="geometry"/></mxCell><mxCell id="p5mce1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mc_rel" target="p5mc_bump"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5mce2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mc_bump" target="p5mf1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5mce3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mf1" target="p5mc_wf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5mcse1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mcs0" target="p5mcs1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5mcse2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mcs1" target="p5mcs2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5mcse3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mcs2" target="p5mcs3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5mcse4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5mcs3" target="p5mcs4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="How a tfvars change flows"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;How a tfvars change flows&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;tfvars live in GitHub (deploy repo ADHPlatform/Custodian_Infrastructure_Deployment_Terraform), not in ADO  ·  example: new SPN for SBX&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1100" height="70" as="geometry"/></mxCell><mxCell id="p6tv0" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;STEP 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Edit the tfvars in GitHub&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;deploy repo, branch: add an entry to spn = { ... } in CoreInfra/SBX/NonProd/SPN.tfvars&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="195" height="165" as="geometry"/></mxCell><mxCell id="p6tv1" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;STEP 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Pull request&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;workflow starts on CoreInfra/** changes: one plan per changed tfvars&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="251" y="125" width="195" height="165" as="geometry"/></mxCell><mxCell id="p6tv2" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;STEP 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Plan&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;on the Cencora runner, steps below; the result shows in the PR&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="462" y="125" width="195" height="165" as="geometry"/></mxCell><mxCell id="p6tv3" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#56636D&quot;&gt;&lt;b&gt;STEP 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Review + merge&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;the team reads the plan, e.g. &amp;quot;1 to add, 0 to change&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EDF0;strokeColor=#56636D;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="673" y="125" width="195" height="165" as="geometry"/></mxCell><mxCell id="p6tv4" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#0F7C74&quot;&gt;&lt;b&gt;STEP 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Apply NonProd&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;manual run from main: env nonprod, tfvars path, action apply&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D9F1ED;strokeColor=#0F7C74;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="884" y="125" width="195" height="165" as="geometry"/></mxCell><mxCell id="p6tv5" value="&lt;font style=&quot;font-size:10px&quot; color=&quot;#B0302F&quot;&gt;&lt;b&gt;STEP 6&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;Same change for Prod&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;PR edits SBX/Prod/SPN.tfvars, plan, prod reviewers, apply&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=1.25;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1095" y="125" width="195" height="165" as="geometry"/></mxCell><mxCell id="p6tv_h" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;&lt;b&gt;INSIDE THE PLAN JOB: EVERYTHING COMES FROM THE FILE PATH&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="1250" height="32" as="geometry"/></mxCell><mxCell id="p6ti0" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;Path&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;CoreInfra/SBX/NonProd/SPN.tfvars&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6ti1" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F6FB2&quot;&gt;&lt;b&gt;Who + where&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;custodian SBX, environment nonprod&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEBF7;strokeColor=#1F6FB2;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="222" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6ti2" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;Version&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;modules_manifest.csv next to it: SPN 0.0.4&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="403" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6ti3" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#6B4FA0&quot;&gt;&lt;b&gt;Module&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;clone ADHPlatform/SPN at v0.0.4 into Modules/SPN&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE6F6;strokeColor=#6B4FA0;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="585" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6ti4" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#B0302F&quot;&gt;&lt;b&gt;Sign in&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;OIDC to the nonprod environment, no secret&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8DFDE;strokeColor=#B0302F;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="766" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6ti5" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#243B6B&quot;&gt;&lt;b&gt;State&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;init with the SBX NonProd state file (same as ADO)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DDE3EF;strokeColor=#243B6B;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="948" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6ti6" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#B85E0E&quot;&gt;&lt;b&gt;Plan + summary&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1F2933&quot;&gt;plan -var-file; PR shows changes or &amp;quot;No changes&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCEBD9;strokeColor=#B85E0E;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1129" y="355" width="163" height="135" as="geometry"/></mxCell><mxCell id="p6tv_note" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1F2933&quot;&gt;&lt;b&gt;The tfvars and manifests move to the GitHub deploy repo with the rest of the files. After cutover the ADO copy is read-only, so every change is made in GitHub.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;No custodian parameter to pick any more: the folder says which custodian and environment, and the manifest beside it says which module version.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;Secrets never go in tfvars: they live as GitHub environment secrets and reach Terraform as TF_VAR_ values.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5F6B76&quot;&gt;A tfvars change and a manifest bump can go in the same PR. Changing several custodians in one PR plans each of them separately.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E8C267;strokeWidth=0.75;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="1250" height="120" as="geometry"/></mxCell><mxCell id="p6tve1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6tv0" target="p6tv1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tve2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6tv1" target="p6tv2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tve3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6tv2" target="p6tv3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tve4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6tv3" target="p6tv4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tve5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6tv4" target="p6tv5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tie1" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6ti0" target="p6ti1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tie2" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6ti1" target="p6ti2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tie3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6ti2" target="p6ti3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tie4" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6ti3" target="p6ti4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tie5" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6ti4" target="p6ti5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6tie6" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#56636D;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#5F6B76;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6ti5" target="p6ti6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="Versions and changelog: ADO vs GitHub"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Versions and changelog: ADO vs GitHub&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6B76&quot;&gt;Feed versions become tags  ·  MODULE_CHAN